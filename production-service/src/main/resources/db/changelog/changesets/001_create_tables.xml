<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="001" author="production-service">
    <comment>Create production-service schema</comment>

    <createTable tableName="wine_recipes">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)"/>
      <column name="production_year" type="INT"/>
      <column name="alcohol_percentage" type="DOUBLE"/>
      <column name="tasting_notes" type="VARCHAR(1000)"/>
      <column name="bottle_volume_liters" type="DOUBLE"/>
    </createTable>

    <createTable tableName="wine_recipe_grape_components">
      <column name="wine_recipe_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_grape_components_recipe"
                     references="wine_recipes(id)"/>
      </column>
      <column name="grape_type" type="VARCHAR(255)"/>
      <column name="kilograms_per_liter" type="DOUBLE"/>
      <column name="preferred_quality" type="INT"/>
    </createTable>

    <createTable tableName="wine_recipe_additional_ingredients">
      <column name="wine_recipe_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_additional_ingredients_recipe"
                     references="wine_recipes(id)"/>
      </column>
      <column name="name" type="VARCHAR(255)"/>
      <column name="quantity_per_liter" type="DOUBLE"/>
      <column name="unit" type="VARCHAR(255)"/>
    </createTable>

    <createTable tableName="production_batches">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="recipe_id" type="UUID"/>
      <column name="planned_liters" type="DOUBLE"/>
      <column name="planned_bottle_count" type="INT"/>
      <column name="actual_bottle_count" type="INT"/>
      <column name="status" type="VARCHAR(255)"/>
      <column name="created_at" type="TIMESTAMP"/>
    </createTable>

    <createTable tableName="outbound_message_log">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="queue_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="VARCHAR(4000)">
        <constraints nullable="false"/>
      </column>
      <column name="batch_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="sent_at" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable tableName="inbound_message_log">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="queue_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="payload" type="VARCHAR(4000)">
        <constraints nullable="false"/>
      </column>
      <column name="batch_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="received_at" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>
